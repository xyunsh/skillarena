# Anthropic API key, only for generating new results (npm run generate -- --backend api). Never commit .env.
ANTHROPIC_API_KEY=
# Optional: GitHub token for higher rate limits when fetching skills (public repos need none)
# GITHUB_TOKEN=

# Where run assets are served from: the published set. Empty: npm run manifest copies local files into web/public/runs/.
ASSET_BASE=https://assets.skillarena.dev

# Only for publishing assets to your own R2 bucket (npm run upload-assets)
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Site build (web/): public API base for the beacon and forms, e.g. /api. Empty: analytics off, forms hidden.
# NEXT_PUBLIC_API_URL=
