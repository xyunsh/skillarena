{
  "name": "skillarena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Compare UI skills for AI coding agents: same brief, same model, with and without the skill.",
  "repository": "github:xyunsh/skillarena",
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "yarn workspace skillarena-web build",
    "contract:check": "tsx contract/check.ts",
    "dev": "yarn workspace skillarena-web dev",
    "discover": "tsx pipeline/discover.ts",
    "fetch-assets": "tsx pipeline/fetch-assets.ts",
    "fetch-skills": "tsx pipeline/fetch-skills.ts",
    "functions:dev": "yarn build && wrangler pages dev web/out --kv WAITLIST",
    "generate": "tsx pipeline/generate.ts",
    "github-meta": "tsx pipeline/github-meta.ts",
    "manifest": "tsx pipeline/build-manifest.ts",
    "og": "tsx pipeline/og.ts",
    "pipeline": "tsx pipeline/run-all.ts",
    "scan": "tsx pipeline/scan-skill.ts",
    "scan-output": "tsx pipeline/scan-output.ts",
    "screenshot": "tsx pipeline/screenshot.ts",
    "share": "tsx pipeline/share.ts",
    "typecheck": "tsc --noEmit && yarn workspace skillarena-web typecheck",
    "upload-assets": "tsx pipeline/upload-assets.ts",
    "upstream": "tsx pipeline/upstream.ts",
    "external-jobs": "tsx pipeline/external-jobs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "playwright": "1.61.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
